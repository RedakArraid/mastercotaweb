# Copier ce fichier en .env et renseigner les valeurs
# Dev local : cp .env.example .env
# Production VPS : créer .env manuellement sur le serveur (ne pas committer)

# Supabase — https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key — server-side uniquement (API routes admin)
# Ne jamais exposer côté client / ne jamais préfixer NEXT_PUBLIC_
# https://app.supabase.com → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — https://dashboard.paystack.com → Settings → API Keys
# pk_test_... en dev / pk_live_... en production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
